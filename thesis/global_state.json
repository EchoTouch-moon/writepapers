{
  "project_title": "基于角色引擎与三层记忆架构的可个性化数字孪生对话系统设计与实现",
  "project_path": "/Users/v/new-idea/wxdata_process",
  "core_objectives": [
    "设计统一角色引擎实现个人数字孪生与企业数字客服的双场景抽象",
    "构建三层记忆架构降低Token消耗并提升记忆一致性",
    "实现动态Prompt机制支持多维度个性化适应",
    "设计拟人化企业客服角色摒弃机械回复"
  ],
  "technical_route": {
    "backend": "FastAPI + SQLite + SQLAlchemy",
    "frontend": "React + Vite + TailwindCSS",
    "vector_store": "FAISS + ChromaDB",
    "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "llm_api": "豆包 API (doubao-seed-2-0-lite-260215)"
  },
  "core_innovations": {
    "role_engine": {
      "file": "backend/role_engine.py",
      "class": "RoleContext",
      "description": "统一角色上下文数据类，支持personal和enterprise两种角色类型",
      "key_features": [
        "统一抽象层消除代码重复",
        "resolve_role()方法自动识别角色类型",
        "build_llm_messages()统一消息构建流程"
      ]
    },
    "three_layer_memory": {
      "file": "backend/advanced_memory_service.py",
      "class": "AdvancedMemoryService",
      "description": "类人记忆巩固与遗忘机制的三层架构",
      "layers": {
        "L1_hot_memory": {
          "type": "热记忆Cache",
          "threshold": "访问次数≥5次提升",
          "max_count": 10,
          "effect": "Token消耗降低40%"
        },
        "L2_journal": {
          "type": "日记层Scratchpad+TimelineJournal",
          "features": ["每日/每周日记", "24小时过期机制", "时间感知"],
          "tables": ["scratchpads", "timeline_journals"]
        },
        "L3_cold_memory": {
          "type": "向量层ChromaDB",
          "threshold": "超过30天的长期记忆",
          "features": ["语义检索", "记忆冲突检测"]
        }
      }
    },
    "dynamic_prompt": {
      "file": "backend/dynamic_prompt_service.py",
      "class": "DynamicPromptService",
      "mechanisms": {
        "semantic_retrieval": "向量相似度检索替代关键词匹配",
        "intent_aware_template": "根据对话意图动态选择Prompt模板",
        "continuous_learning": "从记忆中持续更新Persona特征"
      },
      "intent_types": ["emotional", "informational", "greeting", "farewell", "casual"]
    },
    "emoji_recommendation": {
      "file": "backend/emoji_behavior_service.py",
      "principle": "尊重用户习惯",
      "frequency_map": {
        "none": 0.0,
        "low": 0.2,
        "medium": 0.5,
        "high": 0.8
      }
    },
    "enterprise_knowledge": {
      "file": "backend/enterprise_knowledge_service.py",
      "class": "EnterpriseKnowledgeService",
      "chunk_size": 500,
      "features": ["FAISS语义搜索", "多格式文档支持", "智能分块"]
    }
  },
  "database_tables": {
    "core_tables": [
      {"name": "personas", "description": "统一角色模型", "key_fields": ["role_type", "personality_traits", "common_phrases"]},
      {"name": "role_templates", "description": "企业角色模板", "key_fields": ["system_prompt_template", "allowed_topics"]},
      {"name": "knowledge_bases", "description": "企业知识库", "key_fields": ["source_type", "chunk_count"]},
      {"name": "chat_sessions", "description": "对话会话", "key_fields": ["persona_id", "user_id"]},
      {"name": "messages", "description": "对话消息", "key_fields": ["role", "content", "sentiment"]},
      {"name": "memories", "description": "长期记忆", "key_fields": ["memory_type", "importance_score"]},
      {"name": "hot_memories", "description": "热记忆Cache", "key_fields": ["access_frequency", "memory_type"]},
      {"name": "timeline_journals", "description": "日记层", "key_fields": ["journal_type", "summary", "date"]},
      {"name": "scratchpads", "description": "临时工作区", "key_fields": ["pending_steps", "expires_at"]}
    ],
    "total_tables": 12
  },
  "frontend_components": {
    "pages": ["PersonaPage.jsx", "CSDemoPage.jsx"],
